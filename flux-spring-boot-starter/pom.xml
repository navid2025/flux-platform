<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.navidzaare</groupId>
    <artifactId>flux-platform</artifactId>
    <version>0.1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>flux-spring-boot-starter</artifactId>
  <name>Flux Spring Boot Starter</name>
  <description>
    Single dependency for applications using Flux. Pulls in the connector core,
    the auto-configuration, and the Spring Boot starter it builds on.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.navidzaare</groupId>
      <artifactId>flux-connector-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.navidzaare</groupId>
      <artifactId>flux-starter-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        This module has no classes to document - only a package description - so
        javadoc reports "No public or protected classes found" and would fail the
        release. Tolerating that here keeps the failure intact everywhere else, where
        a javadoc error means something is actually wrong.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <failOnError>false</failOnError>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
