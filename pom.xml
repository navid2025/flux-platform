<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.navidzare</groupId>
  <artifactId>flux-platform</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>Flux Platform</name>
  <description>A lightweight, Spring Boot based ESB development platform.</description>
  <url>https://github.com/navid2025/flux-platform</url>

  <modules>
    <module>flux-connector-core</module>
    <module>flux-connector-kafka</module>
    <module>flux-bpmn-camunda</module>
    <module>flux-starter-autoconfigure</module>
    <module>flux-spring-boot-starter</module>
    <module>examples/demo-app</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.5</spring-boot.version>
    <camunda.version>7.22.0</camunda.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.navidzare</groupId>
        <artifactId>flux-connector-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.navidzare</groupId>
        <artifactId>flux-starter-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.navidzare</groupId>
        <artifactId>flux-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.navidzare</groupId>
        <artifactId>flux-connector-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.navidzare</groupId>
        <artifactId>flux-bpmn-camunda</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Camunda BOM: manages camunda-engine and every other Camunda artifact -->
      <dependency>
        <groupId>org.camunda.bpm</groupId>
        <artifactId>camunda-bom</artifactId>
        <version>${camunda.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.camunda.bpm.springboot</groupId>
        <artifactId>camunda-bpm-spring-boot-starter</artifactId>
        <version>${camunda.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <!-- Keep parameter names in the bytecode so Spring can bind @RequestParam
             and @PathVariable without an explicit name. In a project that does not
             inherit from spring-boot-starter-parent this has to be set by hand. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>navid2025</id>
      <name>Navid Zare</name>
      <url>https://github.com/navid2025</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/navid2025/flux-platform.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/navid2025/flux-platform.git</developerConnection>
    <url>https://github.com/navid2025/flux-platform</url>
    <tag>HEAD</tag>
  </scm>
</project>
