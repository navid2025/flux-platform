<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.navidzaare</groupId>
  <artifactId>flux-platform</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>Flux Platform</name>
  <description>A lightweight, Spring Boot based ESB development platform.</description>
  <url>https://github.com/navidzaare/flux-platform</url>

  <modules>
    <module>flux-connector-core</module>
    <module>flux-connector-kafka</module>
    <module>flux-connector-soap</module>
    <module>flux-bpmn-camunda</module>
    <module>flux-starter-autoconfigure</module>
    <module>flux-spring-boot-starter</module>
    <module>examples/demo-app</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.5</spring-boot.version>
    <camunda.version>7.22.0</camunda.version>
    <cxf.version>4.0.5</cxf.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.navidzaare</groupId>
        <artifactId>flux-connector-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.navidzaare</groupId>
        <artifactId>flux-starter-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.navidzaare</groupId>
        <artifactId>flux-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.navidzaare</groupId>
        <artifactId>flux-connector-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.navidzaare</groupId>
        <artifactId>flux-bpmn-camunda</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.navidzaare</groupId>
        <artifactId>flux-connector-soap</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- WSDL model and parsing. The connector builds envelopes itself, so no
           transport or frontend module is pulled in. -->
      <dependency>
        <groupId>org.apache.cxf</groupId>
        <artifactId>cxf-rt-wsdl</artifactId>
        <version>${cxf.version}</version>
      </dependency>
      <!-- Camunda BOM: manages camunda-engine and every other Camunda artifact -->
      <dependency>
        <groupId>org.camunda.bpm</groupId>
        <artifactId>camunda-bom</artifactId>
        <version>${camunda.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.camunda.bpm.springboot</groupId>
        <artifactId>camunda-bpm-spring-boot-starter</artifactId>
        <version>${camunda.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <!-- Keep parameter names in the bytecode so Spring can bind @RequestParam
             and @PathVariable without an explicit name. In a project that does not
             inherit from spring-boot-starter-parent this has to be set by hand. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <!-- Versioned here so a module can restate this plugin's configuration
             without repeating the version. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.6.3</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>navidzaare</id>
      <name>Navid Zaare</name>
      <url>https://github.com/navidzaare</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/navidzaare/flux-platform.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/navidzaare/flux-platform.git</developerConnection>
    <url>https://github.com/navidzaare/flux-platform</url>
    <tag>v0.1.0</tag>
  </scm>

  <profiles>
    <!--
      Everything needed to publish to Maven Central. Kept in a profile so the normal
      build stays fast and needs no GPG key: activate with -Prelease.

      Versions are pinned deliberately. Version resolution has to query repository
      metadata, which is the thing that breaks behind a mirror that cannot be reached.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>

          <!-- Attach -sources.jar so the central bundle carries readable sources. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <!-- Attach -javadoc.jar. Central rejects a release without one. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <!-- Sign every artifact. The passphrase comes from MAVEN_GPG_PASSPHRASE. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <!--
            Uploads the whole reactor as one bundle to the Central Portal.
            publishingServerId must match the <server><id> in the settings file
            that carries the Portal token.
          -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.9.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <publishingType>AUTOMATIC</publishingType>
            </configuration>
          </plugin>

        </plugins>
      </build>
    </profile>
  </profiles>
</project>
